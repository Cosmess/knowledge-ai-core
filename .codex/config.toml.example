# Example project-level Codex MCP configuration.
# Copy this content into .codex/config.toml when you want Codex to load this MCP server for this repository.

[mcp_servers.dev-knowledge-mcp]
command = "pnpm"
args = ["--dir", "C:\\projetos\\knowledge-ai-core", "dev:mcp"]

[mcp_servers.dev-knowledge-mcp.env]
KNOWLEDGE_API_BASE_URL = "http://localhost:3000"
